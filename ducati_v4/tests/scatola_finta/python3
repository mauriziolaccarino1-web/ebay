#!/bin/bash
# python3 sulla scatola finta: il registratore VERO (dvtool_registratore.py mandato via ssh) gira con un
# socket CAN simulato (finto_can.py), perché qui non c'è SocketCAN. Tutto il resto va al python3 vero.
case "$1" in
  */dvtool_registratore.py) exec /usr/bin/python3 "$(dirname "$0")/finto_can.py" "$@";;
esac
exec /usr/bin/python3 "$@"
